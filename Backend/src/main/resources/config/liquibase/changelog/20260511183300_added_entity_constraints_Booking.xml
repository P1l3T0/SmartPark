<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Booking.
    -->
    <changeSet id="20260511183300-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="user_profile_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__user_profile_id"
                                 referencedColumnNames="id"
                                 referencedTableName="user_profile"
                                 />

        <addForeignKeyConstraint baseColumnNames="vehicle_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__vehicle_id"
                                 referencedColumnNames="id"
                                 referencedTableName="vehicle"
                                 />

        <addForeignKeyConstraint baseColumnNames="parking_spot_id"
                                 baseTableName="booking"
                                 constraintName="fk_booking__parking_spot_id"
                                 referencedColumnNames="id"
                                 referencedTableName="parking_spot"
                                 />
    </changeSet>
</databaseChangeLog>
