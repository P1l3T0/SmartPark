<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260513203647-1" author="manual">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="vehicle" columnName="status"/>
            </not>
        </preConditions>
        <addColumn tableName="vehicle">
            <column name="status" type="varchar(255)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <dropDefaultValue tableName="vehicle" columnName="status" columnDataType="varchar(255)"/>
    </changeSet>
</databaseChangeLog>
